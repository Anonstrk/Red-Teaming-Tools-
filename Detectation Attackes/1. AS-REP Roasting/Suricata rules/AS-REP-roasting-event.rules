alert krb5 $HOME_NET any -> any 88 (msg:"Possible AS-REP Roasting - Multiple Kerberos AS-REQ Attempts"; krb5_msg_type:10; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)

alert krb5 any any -> $HOME_NET any (msg:"Kerberos AS-REP with Weak Encryption - Possible Roasting Target"; flow:to_client; app-layer-event:krb5.weak_encryption; classtype:attempted-recon; sid:1000002; rev:1;)

